{
  "name": "whatsapp-sticker-bot",
  "version": "1.0.1",
  "description": "Bot de WhatsApp que converte imagens e vídeos em figurinhas com o comando !s",
  "main": "src/bot.js",
  "scripts": {
    "build": "npm install && node src/scripts/install-ytdlp.js",
    "start": "node src/bot.js",
    "dev": "node --watch src/bot.js",
    "test:security": "node --test src/handlers/utilidade/downloads.security.test.js",
    "test:api-helpers": "node --test src/utils/mapas.test.js",
    "test:menus": "node --test --test-force-exit src/handlers/menus/menus.test.js",
    "test:futebol": "node --test src/handlers/futebol-api.test.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.21.0",
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^6.7.21",
    "axios": "^1.20.0",
    "bcryptjs": "^3.0.3",
    "cohere-ai": "^7.13.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^12.19.0",
    "fluent-ffmpeg": "^2.1.3",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.1",
    "node-webpmux": "^3.2.1",
    "nodemailer": "^10.0.13",
    "openai": "^4.47.1",
    "pino": "^9.1.0",
    "qrcode": "^1.5.3",
    "resend": "^6.16.0",
    "sharp": "^0.35.5",
    "yt-dlp-wrap": "^2.3.12"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5"
  },
  "keywords": [
    "whatsapp",
    "bot",
    "sticker",
    "figurinha",
    "baileys"
  ],
  "license": "MIT"
}
